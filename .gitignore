# ── Docker ───────────────────────────────────────────────
*.pid

# ── Database ─────────────────────────────────────────────
*.sqlite3
pgdata/

# ── Node / Next.js (web/) ───────────────────────────────
web/node_modules/
web/tsconfig.tsbuildinfo
web/.next/
web/out/
web/.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── ML artifacts ─────────────────────────────────────────
ml/**/*.pkl
ml/**/*.joblib
ml/**/mlruns/

# ── Editor / OS ──────────────────────────────────────────
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# ── Claude Code (cache/session lokal, bukan konvensi proyek) ────
.claude/

# ── Backup database ─────────────────────────────────────
backups/

# ── Eksperimen riset lokal (WLR vs FTS, dsb) — sengaja terisolasi dari
