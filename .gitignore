# ── Python (backend/, ml/) ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ── Environment / secrets ───────────────────────────────
.env
.env.*
