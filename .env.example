# Salin file ini menjadi `.env` di root project untuk override default docker-compose.

POSTGRES_USER=sismon_kepiting
POSTGRES_PASSWORD=ai-dilarangbaca
POSTGRES_DB=sismon_kepiting_db
POSTGRES_PORT=5432

# API key yang harus disertakan gateway (Raspberry Pi) di header X-API-Key saat POST data sensor
GATEWAY_API_KEY=ai-dilarangbaca

# JWT untuk login user (dashboard web / mobile)
JWT_SECRET_KEY=ai-dilarangbaca
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scheduler otomatis pipeline ML (klasifikasi Mamdani + prediksi FTS berkala) —
# jalur sementara di sisi cloud/backend, nantinya pindah ke Raspberry Pi.
ML_SCHEDULER_ENABLED=true
ML_SCHEDULER_INTERVAL_MINUTES=60
ML_HISTORY_HOURS=24
ML_FORECAST_STEPS=6
ML_BUCKET_MINUTES=60

# Reset password via email. Untuk dev lokal tanpa perlu SMTP asli, pakai
# Mailtrap/Mailhog (SMTP palsu buat testing, tidak benar-benar kirim ke inbox nyata).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Push notification (Firebase Cloud Messaging). Kosongkan kalau belum ada
# Firebase project — notifikasi in-app tetap jalan, cuma push-nya yang
# dilewati (dicatat log warning, tidak error).
FIREBASE_CREDENTIALS_PATH=
