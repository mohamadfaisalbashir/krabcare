# Template .env untuk VPS (production) KrabCare. Salin jadi `.env` lalu isi 3 secret.
#   cp env.production.example .env
# JANGAN pernah commit .env asli.
#
# Nama file ini sengaja TANPA titik di depan: .gitignore mengabaikan `.env.*`
# dan hanya mengecualikan `!.env.example`, jadi `.env.production.example` akan
# ikut terabaikan git dan tidak pernah ter-commit.

ENVIRONMENT=production
DEBUG=false

# Domain yang dipakai Caddy untuk menerbitkan sertifikat HTTPS.
# Harus sudah mengarah ke IP VPS sebelum `up -d`, kalau tidak penerbitan gagal.
DOMAIN=api.krabcare.com

# Domain dashboard web (Next.js). Caddy menerbitkan sertifikat terpisah untuk
# domain ini dan mem-proxy-nya ke web:3000.
WEB_DOMAIN=krabcare.com

# Base URL backend yang dipanggil BROWSER dari halaman web, arahkan ke DOMAIN
# di atas, bukan localhost. Di-inline ke bundel saat build image web, jadi
# perubahannya baru berlaku setelah `--build`.
NEXT_PUBLIC_API_BASE_URL=https://api.krabcare.com/api/v1

# --- Rahasia: WAJIB diisi, backend menolak start kalau masih kosong/placeholder ---
# Buat nilai acak: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
GATEWAY_API_KEY=

POSTGRES_USER=krabcare
POSTGRES_DB=krabcare_db
POSTGRES_PORT=5432

ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Bertipe list[str], WAJIB format JSON (kurung siku + kutip ganda),
# BUKAN dipisah koma. Beberapa origin: ["https://a.com","https://b.com"]
CORS_ORIGINS=["https://krabcare.com"]

# Reset password via email (SMTP asli di production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@krabcare.com
SMTP_USE_TLS=true
FRONTEND_RESET_PASSWORD_URL=https://krabcare.com/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Push notification (Firebase Cloud Messaging). Kosongkan kalau belum dipakai,
# notifikasi in-app tetap jalan, push-nya dilewati dengan log warning.
FIREBASE_CREDENTIALS_PATH=
