# Template .env untuk VPS (production). Salin jadi `.env` lalu isi tiga secret:
#   cp env.production.example .env
# Jangan commit .env asli.
#
# Nama berkas ini tanpa titik di depan karena .gitignore mengabaikan `.env.*`
# dan cuma mengecualikan `!.env.example`.

ENVIRONMENT=production
DEBUG=false

# Domain yang dipakai Caddy untuk menerbitkan sertifikat HTTPS.
# Harus sudah mengarah ke IP VPS sebelum `up -d`, kalau tidak penerbitan gagal.
DOMAIN=api.krabcare.com

# Domain dashboard web (Next.js). Caddy menerbitkan sertifikat terpisah untuk
# domain ini dan mem-proxy-nya ke web:3000.
WEB_DOMAIN=krabcare.com

# Base URL backend yang dipanggil browser dari halaman web. Arahkan ke DOMAIN
# di atas, bukan localhost. Di-inline ke bundel saat build image web, jadi
# perubahannya baru berlaku setelah `--build`.
NEXT_PUBLIC_API_BASE_URL=https://api.krabcare.com/api/v1

# Rahasia: wajib diisi, backend menolak start kalau masih kosong atau placeholder.
# Buat nilai acak: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
GATEWAY_API_KEY=

POSTGRES_USER=krabcare
POSTGRES_DB=krabcare_db
POSTGRES_PORT=5432

ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Bertipe list[str], harus format JSON (kurung siku + kutip ganda), bukan
# dipisah koma. Beberapa origin: ["https://a.com","https://b.com"]
CORS_ORIGINS=["https://krabcare.com"]

# Reset password via email (SMTP asli di production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@krabcare.com
SMTP_USE_TLS=true
FRONTEND_RESET_PASSWORD_URL=https://krabcare.com/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Link aktivasi akun baru. Harus alamat publik, bukan localhost: yang membuka
# link ini HP atau komputer penerima email, bukan server.
FRONTEND_VERIFY_EMAIL_URL=https://krabcare.com/verifikasi-email
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=5

# Push notification (Firebase Cloud Messaging). Boleh dikosongkan: notifikasi
# in-app tetap jalan, push-nya dilewati dengan log warning.
FIREBASE_CREDENTIALS_PATH=
