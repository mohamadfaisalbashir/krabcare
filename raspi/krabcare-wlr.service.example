[Unit]
Description=KrabCare, gateway + WLR forecast (edge, Raspi5)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/krabcare-gateway
ExecStart=/usr/bin/python3 /home/pi/krabcare-gateway/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
